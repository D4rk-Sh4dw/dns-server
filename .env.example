# ============================================================
# DNS Dashboard Configuration
# ============================================================
# Copy this file to .env and adjust the values for your setup.
# The .env file is NEVER overwritten by updates.
#
# IMPORTANT: Change default credentials before exposing to any network!
# ============================================================

# --- Dashboard Login ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- Authentication ---
AUTH_SECRET=this_is_a_very_secret_key_for_nextauth

# --- AdGuard Home ---
ADGUARD_USER=admin
ADGUARD_PASS=admin123

# --- Technitium DNS ---
TECHNITIUM_USER=admin
TECHNITIUM_PASSWORD=admin123

# --- Cloudflare DNS Integration (optional) ---
# CLOUDFLARE_EMAIL=your-email@example.com
# CLOUDFLARE_API_TOKEN=your-zone-api-token
# CLOUDFLARE_API_KEY=your-global-api-key

# --- Disable built-in auth when using forward auth (e.g., Authentik) ---
# AUTH_DISABLED=true