server {
    listen 80;
    server_name _;
    absolute_redirect off;
    client_max_body_size 500M;

    # Use Docker's internal DNS resolver to avoid startup failures
    # when upstream containers aren't ready yet
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    # Dashboard (Main App)
    location / {
        proxy_pass http://dns-dashboard:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # AdGuard Home (Protected - requires Dashboard login)
    location /adguard/ {
        # Validate authentication via Dashboard session
        auth_request /auth-validate;
        error_page 401 = @auth_error;

        proxy_pass http://dns-adguard:3000/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Rewrite redirect headers (Location: /login.html -> Location: /adguard/login.html)
        proxy_redirect / /adguard/;
        proxy_redirect http://$http_host/ /adguard/;
        proxy_redirect https://$http_host/ /adguard/;
        proxy_redirect http://$host/ /adguard/;
        proxy_redirect https://$host/ /adguard/;
        proxy_cookie_path / /adguard/;

        # Rewrite content to support subpath
        sub_filter_types text/css text/javascript application/javascript;
        sub_filter 'href="/' 'href="/adguard/';
        sub_filter 'src="/' 'src="/adguard/';
        sub_filter 'action="/' 'action="/adguard/';
        
        # Inject Autologin Script for AdGuard (Robust JS Injection)
        sub_filter '</body>' '<script>
        (function() {
            var attempts = 0;
            var maxAttempts = 20; 
            var interval = setInterval(function() {
                attempts++;
                var u = document.querySelector("input[type=text], input[name=username], #username");
                var p = document.querySelector("input[type=password], input[name=password], #password");
                var b = document.querySelector("button[type=submit], button.btn-primary");
                
                if (u && p && b) {
                     // Check empty
                     if (u.value === "" || p.value === "") {
                        var nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
                        if (nativeInputValueSetter) {
                            nativeInputValueSetter.call(u, "${ADGUARD_USER}");
                            nativeInputValueSetter.call(p, "${ADGUARD_PASS}");
                        } else {
                            u.value = "${ADGUARD_USER}";
                            p.value = "${ADGUARD_PASS}";
                        }
                        ["input", "change", "blur"].forEach(function(evt) {
                            u.dispatchEvent(new Event(evt, { bubbles: true }));
                            p.dispatchEvent(new Event(evt, { bubbles: true }));
                        });
                        setTimeout(function() { b.click(); }, 300);
                        clearInterval(interval);
                     }
                }
                if (attempts >= maxAttempts) clearInterval(interval);
            }, 500);
        })();
        </script></body>';
        
        sub_filter_once off;
    }

    # Technitium DNS (Protected - requires Dashboard login)
    location /technitium/ {
        # Validate authentication via Dashboard session
        auth_request /auth-validate;
        error_page 401 = @auth_error;

        # Use variable so Nginx resolves DNS at runtime, not at startup
        # This prevents "host not found in upstream" errors when Technitium isn't ready yet
        # rewrite strips the /technitium/ prefix before proxying
        rewrite ^/technitium/(.*) /$1 break;
        set $technitium_upstream http://dns-technitium:5380;
        proxy_pass $technitium_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Rewrite cookies path
        proxy_cookie_path / /technitium/;
        proxy_cookie_path /technitium/ /technitium/;

        # Rewrite redirect headers - catch ALL possible internal URLs
        proxy_redirect http://dns-technitium:5380/ /technitium/;
        proxy_redirect http://172.25.0.101:5380/ /technitium/;
        proxy_redirect http://$http_host/ /technitium/;
        proxy_redirect https://$http_host/ /technitium/;
        proxy_redirect http://$host/ /technitium/;
        proxy_redirect https://$host/ /technitium/;
        proxy_redirect / /technitium/;

        # Rewrite content to support subpath - include JSON for API responses
        sub_filter_types text/css text/javascript application/javascript application/json;
        
        # Rewrite absolute URLs with internal Docker addresses (most likely cause of "connection refused")
        sub_filter 'http://dns-technitium:5380/' '/technitium/';
        sub_filter 'http://172.25.0.101:5380/' '/technitium/';
        sub_filter 'http://10.1.0.11:5380/' '/technitium/';
        
        # Rewrite relative URLs
        sub_filter 'href="/' 'href="/technitium/';
        sub_filter 'src="/' 'src="/technitium/';
        sub_filter 'action="/' 'action="/technitium/';
        sub_filter 'url("/' 'url("/technitium/';
        sub_filter 'Url="/' 'Url="/technitium/';

        # Technitium specific API rewrites
        sub_filter '/api/' '/technitium/api/';
        
        # Inject Autologin Script for Technitium (Robust JS Injection)
        sub_filter '</body>' '<script>
        (function() {
            var attempts = 0;
            var maxAttempts = 20;
            var interval = setInterval(function() {
                attempts++;
                var u = document.querySelector("input[type=text], input[name=user], #user");
                var p = document.querySelector("input[type=password], input[name=pass], #pass");
                var b = document.querySelector("button[type=submit], #login-btn, .btn-primary");
                
            if (p && !u) { u = p.previousElementSibling || p.parentElement.previousElementSibling.querySelector("input"); }

                if (u && p && b) {
                    if (u.value === "" || p.value === "") {
                        var nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
                        if (nativeInputValueSetter) {
                            nativeInputValueSetter.call(u, "${TECHNITIUM_USER}");
                            nativeInputValueSetter.call(p, "${TECHNITIUM_PASSWORD}");
                        } else {
                            u.value = "${TECHNITIUM_USER}";
                            p.value = "${TECHNITIUM_PASSWORD}";
                        }
                        ["input", "change", "blur"].forEach(function(evt) {
                            u.dispatchEvent(new Event(evt, { bubbles: true }));
                            p.dispatchEvent(new Event(evt, { bubbles: true }));
                        });
                        setTimeout(function() { b.click(); }, 300);
                        clearInterval(interval);
                    }
                }
                if (attempts >= maxAttempts) clearInterval(interval);
            }, 500);
        })();
        </script></body>';
        
        sub_filter_once off;
    }

    # Internal location for authentication validation
    location = /auth-validate {
        internal;
        proxy_pass http://dns-dashboard:3000/api/auth/validate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
    }

    # Redirect unauthenticated users to login
    location @auth_error {
        return 302 /login?callbackUrl=$request_uri;
    }
}
