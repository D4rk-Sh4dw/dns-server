server {
    listen 80;
    server_name _;
    absolute_redirect off;
    client_max_body_size 500M;

    # Use Docker's internal DNS resolver for runtime DNS resolution
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    # Dashboard (Main App)
    location / {
        set $dashboard_upstream http://dns-dashboard:3000;
        proxy_pass $dashboard_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # AdGuard Home (Protected - requires Dashboard login)
    location /adguard/ {
        # Validate authentication via Dashboard session
        auth_request /auth-validate;
        error_page 401 = @auth_error;
        error_page 500 502 503 504 = @auth_error;

        set $adguard_upstream http://dns-adguard:3000;
        rewrite ^/adguard/(.*) /$1 break;
        proxy_pass $adguard_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CRITICAL: Prevent compressed responses so sub_filter can rewrite content
        proxy_set_header Accept-Encoding "";

        # Rewrite redirect headers (Location: /login.html -> Location: /adguard/login.html)
        proxy_redirect / /adguard/;
        proxy_redirect http://$http_host/ /adguard/;
        proxy_redirect https://$http_host/ /adguard/;
        proxy_redirect http://$host/ /adguard/;
        proxy_redirect https://$host/ /adguard/;
        proxy_cookie_path / /adguard/;

        # Rewrite content to support subpath
        sub_filter_types text/html text/css text/javascript application/javascript;
        sub_filter 'href="/' 'href="/adguard/';
        sub_filter 'src="/' 'src="/adguard/';
        sub_filter 'action="/' 'action="/adguard/';
        
        # Inject Autologin Script for AdGuard (API-based)
        # Must disable compression so sub_filter can modify HTML
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/html;
        sub_filter '</body>' '<script>
        (function() {
            if (document.cookie.indexOf("session=") !== -1) return;
            var attempts = 0;
            var maxAttempts = 30;
            var interval = setInterval(function() {
                attempts++;
                var u = document.querySelector("input[type=text], input[name=username], #username");
                var p = document.querySelector("input[type=password], input[name=password], #password");
                if (u && p) {
                    clearInterval(interval);
                    fetch("/adguard/control/login", {
                        method: "POST",
                        headers: {"Content-Type": "application/json"},
                        body: JSON.stringify({name: "${ADGUARD_USER}", password: "${ADGUARD_PASS}"})
                    }).then(function(r) {
                        if (r.ok) window.location.reload();
                    });
                }
                if (attempts >= maxAttempts) clearInterval(interval);
            }, 500);
        })();
        </script></body>';
        
        sub_filter_once off;
    }

    # Technitium DNS (Protected - requires Dashboard login)
    location /technitium/ {
        # Validate authentication via Dashboard session
        auth_request /auth-validate;
        error_page 401 = @auth_error;
        error_page 500 502 503 504 = @auth_error;

        # Use variable for runtime DNS resolution (Technitium may not be ready at Nginx startup)
        set $technitium_upstream http://dns-technitium:5380;
        rewrite ^/technitium/(.*) /$1 break;
        proxy_pass $technitium_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        # CRITICAL: Technitium natively supports X-Forwarded-Prefix (see DnsWebService.cs)
        # This makes Technitium generate all URLs with /technitium/ prefix automatically
        # No sub_filter hacks needed - the app handles it correctly!
        proxy_set_header X-Forwarded-Prefix /technitium;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # CRITICAL: Override Technitium's X-Frame-Options: DENY to allow iframe embedding
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self';" always;

        # Rewrite cookies path
        proxy_cookie_path / /technitium/;

        # Rewrite redirect headers - catch ALL possible internal URLs
        proxy_redirect http://dns-technitium:5380/ /technitium/;
        proxy_redirect http://172.25.0.101:5380/ /technitium/;
        proxy_redirect http://$http_host/ /technitium/;
        proxy_redirect https://$http_host/ /technitium/;
        proxy_redirect http://$host/ /technitium/;
        proxy_redirect https://$host/ /technitium/;
        proxy_redirect / /technitium/;

        # Inject Autologin Script for Technitium (API-based)
        # Must disable compression so sub_filter can modify HTML
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/html;
        sub_filter '</body>' '<script>
        (function() {
            if (localStorage.getItem("token")) return;
            var attempts = 0;
            var maxAttempts = 30;
            var interval = setInterval(function() {
                attempts++;
                var u = document.querySelector("input[type=text], input[name=user], #user, #txtUser");
                var p = document.querySelector("input[type=password], input[name=pass], #pass, #txtPass");
                if (u && p) {
                    clearInterval(interval);
                    var xhr = new XMLHttpRequest();
                    xhr.open("POST", "/technitium/api/user/login", true);
                    xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
                    xhr.onreadystatechange = function() {
                        if (xhr.readyState === 4 && xhr.status === 200) {
                            try {
                                var resp = JSON.parse(xhr.responseText);
                                if (resp.token) {
                                    localStorage.setItem("token", resp.token);
                                    window.location.reload();
                                }
                            } catch(e) {}
                        }
                    };
                    xhr.send("user=" + encodeURIComponent("${TECHNITIUM_USER}") + "&pass=" + encodeURIComponent("${TECHNITIUM_PASSWORD}") + "&includeInfo=true");
                }
                if (attempts >= maxAttempts) clearInterval(interval);
            }, 500);
        })();
        </script></body>';
        
        sub_filter_once off;
    }

    # Internal location for authentication validation
    location = /auth-validate {
        internal;
        set $auth_upstream http://dns-dashboard:3000;
        proxy_pass $auth_upstream/api/auth/validate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
    }

    # Redirect unauthenticated users to login
    location @auth_error {
        return 302 /login?callbackUrl=$request_uri;
    }
}
