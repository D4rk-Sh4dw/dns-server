server {
    listen 80;
    server_name localhost;

    # Dashboard (Main App)
    location / {
        proxy_pass http://dns-dashboard:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # AdGuard Home
    location /adguard/ {
        proxy_pass http://dns-adguard:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Rewrite redirect headers (Location: /login.html -> Location: /adguard/login.html)
        proxy_redirect / /adguard/;
        proxy_cookie_path / /adguard/;

        # Rewrite content to support subpath
        sub_filter_types text/html text/css text/javascript application/javascript;
        sub_filter 'href="/' 'href="/adguard/';
        sub_filter 'src="/' 'src="/adguard/';
        sub_filter 'action="/' 'action="/adguard/';
        
        # Inject Autologin Script for AdGuard (Robust JS Injection)
        sub_filter '</body>' '<script>
        (function() {
            var attempts = 0;
            var maxAttempts = 20; 
            var interval = setInterval(function() {
                attempts++;
                var u = document.querySelector("input[type=text], input[name=username], #username");
                var p = document.querySelector("input[type=password], input[name=password], #password");
                var b = document.querySelector("button[type=submit], button.btn-primary");
                
                if (u && p && b) {
                     // Check empty
                     if (u.value === "" || p.value === "") {
                        var nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
                        if (nativeInputValueSetter) {
                            nativeInputValueSetter.call(u, "${ADGUARD_USER}");
                            nativeInputValueSetter.call(p, "${ADGUARD_PASS}");
                        } else {
                            u.value = "${ADGUARD_USER}";
                            p.value = "${ADGUARD_PASS}";
                        }
                        ["input", "change", "blur"].forEach(function(evt) {
                            u.dispatchEvent(new Event(evt, { bubbles: true }));
                            p.dispatchEvent(new Event(evt, { bubbles: true }));
                        });
                        setTimeout(function() { b.click(); }, 300);
                        clearInterval(interval);
                     }
                }
                if (attempts >= maxAttempts) clearInterval(interval);
            }, 500);
        })();
        </script></body>';
        
        sub_filter_once off;
    }

    # Technitium DNS
    location /technitium/ {
        proxy_pass http://dns-technitium:5380/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Rewrite cookies path
        proxy_cookie_path / /technitium/;

        # Rewrite content to support subpath
        sub_filter_types text/html text/css text/javascript application/javascript;
        sub_filter 'href="/' 'href="/technitium/';
        sub_filter 'src="/' 'src="/technitium/';
        sub_filter 'action="/' 'action="/technitium/';

        # Technitium specific API rewrites
        sub_filter '/api/' '/technitium/api/';
        
        # Inject Autologin Script for Technitium (Robust JS Injection)
        sub_filter '</body>' '<script>
        (function() {
            var attempts = 0;
            var maxAttempts = 20;
            var interval = setInterval(function() {
                attempts++;
                var u = document.querySelector("input[type=text], input[name=user], #user");
                var p = document.querySelector("input[type=password], input[name=pass], #pass");
                var b = document.querySelector("button[type=submit], #login-btn, .btn-primary");
                
                if (p && !u) { u = p.previousElementSibling || p.parentElement.previousElementSibling.querySelector("input"); }

                if (u && p && b) {
                    if (u.value === "" || p.value === "") {
                        var nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
                        if (nativeInputValueSetter) {
                            nativeInputValueSetter.call(u, "${TECHNITIUM_USER}");
                            nativeInputValueSetter.call(p, "${TECHNITIUM_PASSWORD}");
                        } else {
                            u.value = "${TECHNITIUM_USER}";
                            p.value = "${TECHNITIUM_PASSWORD}";
                        }
                        ["input", "change", "blur"].forEach(function(evt) {
                            u.dispatchEvent(new Event(evt, { bubbles: true }));
                            p.dispatchEvent(new Event(evt, { bubbles: true }));
                        });
                        setTimeout(function() { b.click(); }, 300);
                        clearInterval(interval);
                    }
                }
                if (attempts >= maxAttempts) clearInterval(interval);
            }, 500);
        })();
        </script></body>';
        
        sub_filter_once off;
    }
}
